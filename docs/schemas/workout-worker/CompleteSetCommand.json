{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "CompleteSetCommand"
    },
    "exerciseIndex": {
      "type": "integer"
    },
    "setIndex": {
      "type": "integer"
    },
    "weight": {
      "$ref": "./Weight.json"
    },
    "reps": {
      "type": "integer"
    }
  },
  "required": [
    "type",
    "exerciseIndex",
    "setIndex"
  ]
}
